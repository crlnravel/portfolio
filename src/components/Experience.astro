---
const roles = [
	{
		role: 'Product Researcher & Developer',
		company: 'Apple Developer Academy',
		date: 'Mar 2026 — Present',
		detail: 'Designing and developing native Apple-platform applications with SwiftUI. The work moves through user research, rapid prototypes, usability tests, and close collaboration with multidisciplinary teams.',
	},
	{
		role: 'Software Engineer Intern',
		company: 'QuorumAI',
		date: 'Mar — Nov 2025',
		detail: 'Built production backend services in Go for AI-powered meeting workflows, shaped REST APIs and microservices, and optimized PostgreSQL paths that contributed to an approximate 40% reduction in API latency.',
	},
	{
		role: 'Web Developer',
		company: 'Freelance',
		date: 'Jun 2024 — Present',
		detail: 'Owns projects end to end: clarifying requirements directly with clients, translating business needs into maintainable systems, and carrying the work through implementation and deployment.',
	},
	{
		role: 'AI / ML Mentor',
		company: 'Pusilkom UI × Medco Energi',
		date: 'Nov — Dec 2025',
		detail: 'Mentored professionals through applied AI and machine-learning projects, with emphasis on model evaluation, experimentation, and connecting technical results to practical business needs.',
	},
];
---

	<section class="section shell experience-section" id="experience" data-section>
	<div class="experience-head" data-reveal>
		<div>
			<span class="eyebrow">03 · Experience</span>
			<h2 class="section-title">Built through shipping, not just studying.</h2>
		</div>
	</div>

	<div class="experience-tiles" data-reveal>
		{roles.map((item, index) => (
			<button
				class="experience-tile"
				type="button"
				aria-haspopup="dialog"
				aria-expanded="false"
				aria-controls={`experience-dialog-${index}`}
				data-experience-button
			>
				<span class="experience-tile-top">
					<span class="experience-tile-index">0{index + 1} / ROLE</span>
					<span class="experience-tile-title">{item.company}</span>
				</span>
				<span class="experience-tile-footer">
					<span class="experience-tile-role">{item.role}</span>
					<span class="experience-tile-date">{item.date}</span>
				</span>
			</button>
		))}
	</div>

	<div class="experience-dialogs">
		{roles.map((item, index) => (
			<dialog
				class="experience-dialog"
				id={`experience-dialog-${index}`}
				aria-modal="true"
				aria-labelledby={`experience-dialog-title-${index}`}
				data-experience-dialog
			>
				<div class="experience-dialog-shell">
					<div class="experience-dialog-meta">
						<span>0{index + 1} · Experience</span>
					</div>
					<div class="experience-dialog-content">
						<p class="experience-dialog-company">{item.company}</p>
						<h3 id={`experience-dialog-title-${index}`}>{item.role}</h3>
						<p class="experience-dialog-date">{item.date}</p>
						<p class="experience-dialog-detail">{item.detail}</p>
					</div>
					<form method="dialog">
						<button class="experience-dialog-close" type="submit" aria-label="Close dialog" data-gallery-close>
							<span aria-hidden="true">×</span>
						</button>
					</form>
				</div>
			</dialog>
		))}
	</div>
</section>
