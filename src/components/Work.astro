---
const projects = [
	{
		name: 'EduVate',
		platform: 'Web · Inclusive learning',
		role: 'Team project',
		timeline: 'Academic project · Universitas Indonesia',
		tech: 'React Router · NestJS · PostgreSQL · Prisma · Redis · OpenAI · Google TTS',
		image: '/projects/eduvate-preview.png',
		website: null,
		copy: 'A voice-first learning platform designed to make coursework more accessible for students with visual impairments. EduVate combines voice navigation, audio learning materials, role-aware course management, timed quiz workflows, and AI-assisted content processing with separate student and teacher dashboards.',
	},
	{
		name: 'QuorumAI',
		platform: 'Web · Meeting intelligence',
		role: 'Software Engineer Intern',
		timeline: 'Mar — Nov 2025',
		tech: 'Go · PostgreSQL · REST APIs · SSE · Object storage',
		image: '/projects/quorum-ai-landing.jpg',
		imageFit: 'cover',
		website: 'https://quorum-ai.com',
		copy: 'An LLM-powered meeting management platform that turns real-time recordings into transcripts, summaries, translations, meeting prep, and an interactive AI chat. As a Software Engineer Intern, I built production Go backend services, optimized REST APIs and PostgreSQL queries to reduce average API latency by approximately 40%, and implemented authentication, SSE, and secure object-storage access.',
	},
	{
		name: 'Indonesian ALPR Project',
		platform: 'Machine learning · Computer vision',
		role: 'Model development · ML engineering',
		timeline: 'Independent project',
		tech: 'YOLO11 · PyTorch · ONNX · TFLite · OpenCV',
		image: '/projects/indonesian-alpr-preview.png',
		imageFit: 'contain',
		website: null,
		links: [
			{ label: 'Hugging Face detector', href: 'https://huggingface.co/carlravel/indonesian-plate-detector-yolo11' },
			{ label: 'Hugging Face recognizer', href: 'https://huggingface.co/carlravel/indonesian-plate-recognizer-yolo11' },
			{ label: 'GitHub source', href: 'https://github.com/crlnravel/indonesian-plate-alpr' },
		],
		copy: 'An end-to-end two-stage deep learning pipeline for Indonesian vehicle license plate detection and character recognition. The plate detector localizes license-plate regions, while a 36-class YOLO11 recognizer reads 0–9 and A–Z characters and reassembles them into standardized plate strings. The models support PyTorch, ONNX, and TFLite runtimes. On the official validation splits, the detector reached 98.84% mAP@0.5 and the recognizer reached 98.40% mAP@0.5.',
	},
	{
		name: 'Trisurya',
		platform: 'Research · E-government AI',
		role: 'Research · Published paper',
		timeline: 'Published · IEEE ICIMCIS 2024',
		tech: 'GPT-4 / GPT-4o · RAG · Neo4j · PostgreSQL',
		image: '/projects/trisurya-preview.png',
		imageFit: 'contain',
		website: null,
		copy: 'An omnichannel chatbot for government and public-service information in Indonesian, Javanese, Sundanese, and Balinese. Published at the 2024 IEEE International Conference on Informatics, Multimedia, Cyber and Information System (ICIMCIS), the research combines GPT APIs with Retrieval-Augmented Generation, Neo4j, and PostgreSQL to ground its answers. The study found GPT-4o offered similar performance to GPT-4 at lower cost and reported stronger quantitative and qualitative results than several widely used chatbots.',
	},
	{
		name: 'COMPFEST',
		platform: 'Web · IT event platform',
		role: 'Vice PIC (DevOps) · Software Engineering',
		timeline: 'Mar 2025 — Jan 2026',
		tech: 'CI/CD · GitHub Actions · Automation · Deployment reliability',
		image: '/projects/compfest-preview.png',
		website: null,
		copy: 'COMPFEST is an annual, student-run IT event from the Faculty of Computer Science, Universitas Indonesia, held since 2009 and recognized as Indonesia’s biggest IT event. As Vice PIC (DevOps) in the Software Engineering Division, I led web developers, strengthened software development and deployment practices, built CI/CD pipelines, and automated repetitive operational work.',
	},
	{
		name: 'Lookals',
		platform: 'Apple platforms',
		role: 'Product engineering',
		timeline: 'Product development · 2026',
		tech: 'SwiftUI · Real-time collaboration',
		image: '/projects/LookalsPresentation.jpeg',
		website: null,
		links: [{ label: 'GitHub', href: 'https://github.com/crlnravel/lookals' }],
		copy: 'A location-based social experience designed to help newcomers explore unfamiliar places together. Built with SwiftUI and real-time collaboration to encourage meaningful connections through shared exploration.',
	},
	{
		name: 'RISTEK.Link',
		platform: 'Web · URL shortener',
		role: 'Open-source web project',
		timeline: 'RISTEK Fasilkom UI',
		tech: 'Next.js · TypeScript · Tailwind CSS · Chakra UI · Cloudflare Workers · Cloudflare KV',
		image: '/projects/ristek-link.webp',
		imageFit: 'contain',
		website: 'https://www.ristek.link/',
		links: [{ label: 'GitHub source', href: 'https://github.com/ristekoss/ristek-link' }],
		copy: 'A no-login, open-source URL shortener built around a simple paste, shorten, and copy workflow. The project combines a Next.js and TypeScript frontend with a serverless Cloudflare Workers function and Cloudflare KV for storing and retrieving shortened URLs.',
	},
];
---

<section class="work" id="work" data-section>
	<div class="section shell">
		<div class="work-head" data-reveal>
			<div>
				<span class="eyebrow">04 · Projects</span>
				<h2 class="section-title">Building products that people can actually rely on.</h2>
			</div>
		</div>

		<div class="project-gallery" data-projects data-reveal>
			{projects.map((project, index) => (
				<button
					class="project-card"
					type="button"
					aria-haspopup="dialog"
					aria-expanded="false"
					aria-controls={`project-dialog-${index}`}
					aria-label={`Open details for ${project.name}`}
					data-project-button
				>
					<img
						class="project-card-image"
						src={project.image}
						alt=""
						aria-hidden="true"
						loading={index === 0 ? 'eager' : 'lazy'}
					/>
					<span class="project-card-label" aria-hidden="true">
						<span class="project-card-number">0{index + 1} / PROJECT</span>
						<span class="project-card-title">{project.name}</span>
					</span>
				</button>
			))}
		</div>

		<div class="project-dialogs">
			{projects.map((project, index) => (
				<dialog
					class="experience-dialog project-dialog"
					id={`project-dialog-${index}`}
					aria-modal="true"
					aria-labelledby={`project-dialog-title-${index}`}
					data-project-dialog
				>
					<div class="experience-dialog-shell project-dialog-shell">
						<div class="experience-dialog-meta">
							<span>0{index + 1} · Project</span>
						</div>
						<div class="project-dialog-layout">
							<div class="project-dialog-visual">
								<img
									class:list={['project-dialog-image', { 'project-dialog-image--contain': project.imageFit === 'contain' }]}
									src={project.image}
									alt=""
									aria-hidden="true"
								/>
							</div>
							<div class="experience-dialog-content">
								<p class="experience-dialog-company">{project.platform}</p>
								<h3 id={`project-dialog-title-${index}`}>{project.name}</h3>
								{(project.website || project.links?.length) && (
									<div class="project-dialog-links">
										{project.website && (
											<a href={project.website} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name} website`}>
												<svg class="project-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93Zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39Z"/></svg>
												<span>Visit website</span>
											</a>
										)}
										{project.links?.map((link) => (
											<a href={link.href} target="_blank" rel="noreferrer">
												{link.href.includes('github.com') ? (
													<svg class="project-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.54-3.87-1.54-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.26-1.28-5.26-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.12 3.04.74.8 1.19 1.82 1.19 3.08 0 4.42-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.18v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
												) : (
													<svg class="project-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93Zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39Z"/></svg>
												)}
												<span>{link.label}</span>
											</a>
										))}
									</div>
								)}
								<p class="experience-dialog-detail">{project.copy}</p>
								<dl class="project-dialog-facts">
									<div><dt>Role</dt><dd>{project.role}</dd></div>
									<div><dt>Timeline</dt><dd>{project.timeline}</dd></div>
									<div><dt>Tech</dt><dd>{project.tech}</dd></div>
								</dl>
							</div>
						</div>
						<form method="dialog">
							<button class="experience-dialog-close" type="submit" aria-label="Close dialog" data-gallery-close>
								<span aria-hidden="true">×</span>
							</button>
						</form>
					</div>
				</dialog>
			))}
		</div>
	</div>
</section>
