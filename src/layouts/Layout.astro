---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
}

const {
	title = 'Carleano Ravelza Wongso — Software Engineer',
	description = 'Carleano Ravelza Wongso is a Jakarta-based software engineer and computer science student building scalable systems and intelligent products.',
	canonicalPath = '/',
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://carlravel.tech');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#D4DE95" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100,400..700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
</body>
</html>
