---
import Arrow from '../components/Arrow.astro';
import Experience from '../components/Experience.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TechMarquee from '../components/TechMarquee.astro';
import Work from '../components/Work.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<a class="skip-link" href="#main">Skip to main content</a>
	<SiteHeader />
	<aside class="progress-rail" aria-hidden="true">
		<div class="rail-line"><div class="rail-fill" data-progress></div></div>
	</aside>

	<main id="main">
		<section class="hero shell" id="home" data-section>
			<div class="hero-grid">
				<div class="hero-copy hero-enter">
					<h1 class="display">I build software that stays reliable as <em>ideas</em> become products.</h1>
				</div>
				<div class="hero-side hero-enter hero-enter-delay">
					<div>
						<div class="hero-actions">
							<a class="button button-primary" href="#work">View selected work <Arrow /></a>
							<a class="button" href="/Resume_CarleanoRavelzaWongso.pdf" download="Carleano-Ravelza-Wongso-CV.pdf">Download CV</a>
						</div>
						<div class="social-row">
							<a href="https://github.com/crlnravel" target="_blank" rel="noreferrer" aria-label="GitHub profile" title="GitHub">
								<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.54-3.87-1.54-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.26-1.28-5.26-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.12 3.04.74.8 1.19 1.82 1.19 3.08 0 4.42-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.18v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
								</svg>
							</a>
							<a href="https://www.linkedin.com/in/carleano-ravelza-wongso/" target="_blank" rel="noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
								<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0ZM.5 8.5h4V23h-4V8.5Zm6.5 0h3.83v1.98h.05c.53-1.01 1.84-2.48 4.5-2.48 4.82 0 5.62 3.17 5.62 7.3V23h-4v-6.84c0-1.63-.03-3.72-2.27-3.72-2.27 0-2.62 1.77-2.62 3.6V23H7V8.5Z" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="about" id="about" data-section>
			<div class="section shell">
				<div class="about-grid" data-reveal>
					<figure class="about-portrait">
						<img src="/Ravel Profile.jpg" alt="Carleano Ravelza Wongso" loading="lazy" />
					</figure>
					<div class="about-copy">
						<span class="eyebrow">02 · About</span>
						<h2 class="section-title">Hi, I'm Carl. I love to move fast and break things!</h2>
						<p>Computer science student at Universitas Indonesia and software engineer building scalable web applications, backend systems, and AI-powered products with a focus on reliability and user experience.</p>
					</div>
				</div>
			</div>
		</section>

		<Experience />
		<TechMarquee />
		<Work />

		<section class="section shell" id="recognition" data-section>
			<div data-reveal>
				<span class="eyebrow">05 · Achievements</span>
				<h2 class="section-title">Selected achievements.</h2>
			</div>
			<div class="recognition-layout" data-reveal>
				<div class="award-list">
					<div class="award"><span class="award-place">1st</span><div><div class="award-name">Web Application Competition</div><div class="award-org">Politeknik Negeri Semarang</div></div><span class="award-year">2025</span></div>
					<div class="award"><span class="award-place">2nd</span><div><div class="award-name">FindIT Hackathon</div><div class="award-org">Universitas Gadjah Mada</div></div><span class="award-year">2025</span></div>
				</div>
			</div>
		</section>

		<section class="contact" id="contact" data-section>
			<div class="section shell contact-layout">
				<div data-reveal>
					<span class="eyebrow">06 · Contact</span>
					<h2 class="contact-title">Have an idea worth building?</h2>
					<a class="button button-primary" href="mailto:carleanoravel@gmail.com">Get in touch <Arrow /></a>
				</div>
				<aside class="contact-side" data-reveal>
					<p>I’m always interested in software engineering opportunities, ambitious products, and conversations about systems, AI, and developer tools.</p>
					<div class="contact-links">
						<a href="mailto:carleanoravel@gmail.com"><span>carleanoravel@gmail.com</span><span>↗</span></a>
						<a href="https://www.linkedin.com/in/carleano-ravelza-wongso/" target="_blank" rel="noreferrer"><span>LinkedIn</span><span>↗</span></a>
						<a href="https://github.com/crlnravel" target="_blank" rel="noreferrer"><span>GitHub</span><span>↗</span></a>
						<a href="/Resume_CarleanoRavelzaWongso.pdf" download="Carleano-Ravelza-Wongso-CV.pdf"><span>Download CV</span><span>↓</span></a>
						<span class="contact-location">Based in Jakarta, Indonesia</span>
					</div>
				</aside>
			</div>
		</section>
	</main>

	<footer class="footer"><div class="shell footer-inner"><span>© 2026 Carleano Ravelza Wongso</span><span>Built with care</span></div></footer>
	<script src="../scripts/portfolio.ts"></script>
</Layout>
